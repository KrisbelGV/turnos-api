# Prueba de los ejercicios 1 y 2.
# Requiere el servidor corriendo en localhost:8080 con los 25 turnos de data.sql.
# Ejecutar request por request, o usar "Run All Requests in File".

@base = http://localhost:8080

# ==============================================
# Ejercicio 1: paginación
# ==============================================

# 1.1 v1 página 0, size 5
# Esperado: 200, 5 elementos, pagina 0, tamanio 5, totalElementos 25, totalPaginas 5.
#           Cada elemento con fechaHora.
###
GET {{base}}/api/turnos?page=0&size=5
API-Version: 1.0

# 1.2 v2 página 0, size 5
# Esperado: 200, 5 elementos, totalElementos 25, totalPaginas 5.
#           Cada elemento con fecha y hora separadas, sin fechaHora.
###
GET {{base}}/api/turnos?page=0&size=5
API-Version: 2.0

# 1.3 última página parcial (page 2, size 10)
# Esperado: 200, 5 elementos, pagina 2, totalPaginas 3.
###
GET {{base}}/api/turnos?page=2&size=10
API-Version: 2.0

# 1.4 página fuera de rango (page 99, size 10)
# Esperado: 200, contenido vacío, totalElementos 25, totalPaginas 3.
###
GET {{base}}/api/turnos?page=99&size=10
API-Version: 2.0

# 1.5 defaults (sin page ni size)
# Esperado: 200, pagina 0, tamanio 20, 20 elementos, totalPaginas 2.
###
GET {{base}}/api/turnos
API-Version: 2.0

# 1.6 filtro por estado CONFIRMADO
# Esperado: 200, totalElementos 9, totalPaginas 2, todos CONFIRMADO.
###
GET {{base}}/api/turnos?estado=CONFIRMADO&page=0&size=5
API-Version: 2.0

# 1.7 filtro por cliente 'ana'
# Esperado: 200, todos los clientes contienen 'ana' (case-insensitive).
###
GET {{base}}/api/turnos?cliente=ana&page=0&size=5
API-Version: 2.0

# 1.8 page negativo (page -1)
# Esperado: 400 Bad Request con errores.page.
###
GET {{base}}/api/turnos?page=-1&size=10
API-Version: 2.0

# 1.9 size fuera de rango (size 500)
# Esperado: 400 Bad Request con errores.size.
###
GET {{base}}/api/turnos?page=0&size=500
API-Version: 2.0

# ==============================================
# Ejercicio 2: horario laboral
# ==============================================

# 2.1 lunes 10:30
# Esperado: 201 Created.
###
POST {{base}}/api/turnos
Content-Type: application/json

{
  "cliente": "Test Lunes",
  "servicio": "Corte de pelo",
  "fechaHora": "2030-03-11T10:30:00"
}

# 2.2 sábado 18:59
# Esperado: 201 Created.
###
POST {{base}}/api/turnos
Content-Type: application/json

{
  "cliente": "Test Sábado",
  "servicio": "Corte de pelo",
  "fechaHora": "2030-03-16T18:59:00"
}

# 2.3 límite 9:00
# Esperado: 201 Created (límite inferior inclusivo).
###
POST {{base}}/api/turnos
Content-Type: application/json

{
  "cliente": "Test Límite",
  "servicio": "Corte de pelo",
  "fechaHora": "2030-03-11T09:00:00"
}

# 2.4 límite 19:00
# Esperado: 201 Created (límite superior inclusivo).
###
POST {{base}}/api/turnos
Content-Type: application/json

{
  "cliente": "Test Límite",
  "servicio": "Corte de pelo",
  "fechaHora": "2030-03-12T19:00:00"
}

# 2.5 domingo 10:00
# Esperado: 400 Bad Request con errores.fechaHora.
###
POST {{base}}/api/turnos
Content-Type: application/json

{
  "cliente": "Test Domingo",
  "servicio": "Corte de pelo",
  "fechaHora": "2030-03-17T10:00:00"
}

# 2.6 lunes 8:59
# Esperado: 400 Bad Request con errores.fechaHora.
###
POST {{base}}/api/turnos
Content-Type: application/json

{
  "cliente": "Test Antes",
  "servicio": "Corte de pelo",
  "fechaHora": "2030-03-11T08:59:00"
}

# 2.7 lunes 19:01
# Esperado: 400 Bad Request con errores.fechaHora.
###
POST {{base}}/api/turnos
Content-Type: application/json

{
  "cliente": "Test Después",
  "servicio": "Corte de pelo",
  "fechaHora": "2030-03-12T19:01:00"
}