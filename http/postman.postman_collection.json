      "name": "1 · Paginación",
      "item": [
        {
          "name": "1.1 · v1 página 0, size 5",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('5 elementos', () => pm.expect(b.contenido.length).to.eql(5));",
                  "pm.test('pagina 0', () => pm.expect(b.pagina).to.eql(0));",
                  "pm.test('tamanio 5', () => pm.expect(b.tamanio).to.eql(5));",
                  "pm.test('totalElementos 25', () => pm.expect(b.totalElementos).to.eql(25));",
                  "pm.test('totalPaginas 5', () => pm.expect(b.totalPaginas).to.eql(5));",
                  "pm.test('v1 usa fechaHora', () => pm.expect(b.contenido[0]).to.have.property('fechaHora'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "API-Version", "value": "1.0" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/turnos?page=0&size=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "turnos"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" }
              ]
            }
          }
        },
