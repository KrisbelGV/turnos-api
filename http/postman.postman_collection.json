                  "pm.test('totalPaginas 5', () => pm.expect(b.totalPaginas).to.eql(5));",
                  "pm.test('v2 usa fecha y hora separadas', () => {",
                  "  pm.expect(b.contenido[0]).to.have.property('fecha');",
                  "  pm.expect(b.contenido[0]).to.have.property('hora');",
